# Copy to .env (local) or set in your host's dashboard. Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/premium_estate?schema=public"

# Public base URL, no trailing slash (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random string (e.g. `openssl rand -base64 48`). Salts hashed IPs for rate limiting.
SESSION_SECRET="replace-with-a-long-random-string"

# ── Media storage (Cloudinary) — required for photo/brochure uploads ─────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: folder prefix inside your Cloudinary account
CLOUDINARY_FOLDER="real-estate"
# Optional: per-file upload limit in MB (default 8)
MAX_UPLOAD_MB="8"

# ── Email (Resend) — required for enquiry notifications ──────────────────
RESEND_API_KEY=""
# A sender on a domain you have verified in Resend, e.g. "Company Name <hello@yourdomain.com>"
EMAIL_FROM=""
# Optional: comma-separated staff inboxes for new-enquiry alerts.
# Falls back to the email address in Admin › Content › Site settings.
NOTIFY_EMAIL=""

# ── Optional ──────────────────────────────────────────────────────────────
# Listing reference prefix, e.g. ABC → ABC-2026-0001
LISTING_REF_PREFIX="ACP"
# Default currency used by the seed script
DEFAULT_CURRENCY="NGN"
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Loaded only after visitor consent.
NEXT_PUBLIC_GA_ID=""
# Google Search Console HTML-tag verification code (the content="…" value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Optional cookie-free analytics (Plausible) as an alternative or addition to GA4
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
